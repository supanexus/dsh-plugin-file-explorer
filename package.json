{
  "name": "@supanexus/dsh-plugin-file-explorer",
  "description": "SupaNexus workspace file explorer: sidebar tree and center-column multi-tab editor",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "author": "SupaNexus",
  "homepage": "https://github.com/supanexus/dsh-plugin-file-explorer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/supanexus/dsh-plugin-file-explorer.git"
  },
  "bugs": {
    "url": "https://github.com/supanexus/dsh-plugin-file-explorer/issues"
  },
  "keywords": [
    "dsh-plugin",
    "supanexus",
    "deepseek-harness",
    "file-explorer",
    "monaco"
  ],
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/types/typert.host.d.ts",
      "default": "./lib/types/typert.host.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "whale": {
    "layer": "ui",
    "dshPlugin": true,
    "publish": {
      "github": true,
      "repo": "supanexus/dsh-plugin-file-explorer",
      "topics": ["dsh-plugin", "supanexus", "deepseek-harness", "file-explorer", "monaco"]
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -b && tsdown --env.DSH_BUILD_FACE client",
    "bundle": "pnpm run build",
    "test": "vitest run",
    "watch": "tsc -b --watch"
  },
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/typert.host.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "marked": "^18.0.9",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-api-remotes": "*",
    "@deepseek-ai/dsh-client-locale": "*",
    "@deepseek-ai/dsh-client-ui-conversation": "*",
    "@deepseek-ai/dsh-client-ui-renderer": "*",
    "@deepseek-ai/dsh-client-ui-settings": "*",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "*",
    "@deepseek-ai/dsh-client-ui-sidebar": "*",
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/dsh-typert-protocol": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-api-remotes": { "optional": true },
    "@deepseek-ai/dsh-client-locale": { "optional": true },
    "@deepseek-ai/dsh-client-ui-conversation": { "optional": true },
    "@deepseek-ai/dsh-client-ui-renderer": { "optional": true },
    "@deepseek-ai/dsh-client-ui-settings": { "optional": true },
    "@deepseek-ai/dsh-client-ui-settings-plugins": { "optional": true },
    "@deepseek-ai/dsh-client-ui-sidebar": { "optional": true },
    "@deepseek-ai/dsh-settings": { "optional": true },
    "@deepseek-ai/dsh-typert-protocol": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "file:../../../../engine/vendor/cordis",
    "@deepseek-ai/dsh-api-remotes": "file:../../../../engine/packages/api/remotes",
    "@deepseek-ai/dsh-client-locale": "file:../../../../engine/packages/client/locale",
    "@deepseek-ai/dsh-client-ui-conversation": "file:../../../../engine/packages/client/ui-conversation",
    "@deepseek-ai/dsh-client-ui-renderer": "file:../../../../engine/packages/client/ui-renderer",
    "@deepseek-ai/dsh-client-ui-settings": "file:../../../../engine/packages/client/ui-settings",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "file:../../../../engine/packages/client/ui-settings-plugins",
    "@deepseek-ai/dsh-client-ui-sidebar": "file:../../../../engine/packages/client/ui-sidebar",
    "@deepseek-ai/dsh-client-ui-slots": "file:../../../../engine/packages/client/ui-slots",
    "@deepseek-ai/dsh-invariants": "file:../../../../engine/packages/runtime-diagnostics/invariants",
    "@deepseek-ai/dsh-settings": "file:../../../../engine/packages/settings/settings",
    "@deepseek-ai/dsh-typert-protocol": "file:../../../../engine/packages/typert/protocol",
    "@deepseek-ai/schemastery": "file:../../../../engine/vendor/schemastery",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^20.19.0",
    "@types/react": "~18.3.1",
    "jsdom": "^26.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
